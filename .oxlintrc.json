{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "react/exhaustive-deps": "warn"
  }
}
